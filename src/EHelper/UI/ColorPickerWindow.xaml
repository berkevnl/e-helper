<Window x:Class="EHelper.UI.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color"
        Width="396"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Window.Resources>
        <!-- Windows 11 Modern Dark Color Swatch Button Style -->
        <Style x:Key="ModernSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="1" BorderThickness="1" BorderBrush="#2A2A2A">
                            <Rectangle x:Name="focusRect" Stroke="White" StrokeThickness="1.5" Margin="1" Opacity="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="focusRect" Property="Opacity" Value="1"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Native Button Style (OK / Cancel) -->
        <Style x:Key="WinDialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="86"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383838"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dialog Outer Frame: Clean Windows Native Dark #1F1F1F with 1px border #383838 -->
    <Border Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1" CornerRadius="4" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Color Canvas & Spectrum + Preview -->
                <RowDefinition Height="Auto"/> <!-- 3-Row Color Swatches Matrix -->
                <RowDefinition Height="Auto"/> <!-- OK / Cancel Buttons -->
            </Grid.RowDefinitions>

            <!-- 0: Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock x:Name="TxtDialogTitle" Text="Color" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="✕" Width="26" Height="22" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#8E8E93" BorderThickness="0" 
                        FontSize="11" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBrd" Background="{TemplateBinding Background}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBrd" Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 1: Upper Section: [2D Spectrum Canvas] [1D Hue Bar] [Preview + Hex + RGB] -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188"/> <!-- 2D Saturation / Value Canvas -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="18"/>  <!-- Vertical Hue Bar -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>   <!-- Preview Box + Hex + RGB -->
                </Grid.ColumnDefinitions>

                <!-- 2D Saturation / Value Box (188 x 188 Square Canvas) -->
                <Border Grid.Column="0" Width="188" Height="188" BorderBrush="#383838" BorderThickness="1" ClipToBounds="True" Cursor="Cross"
                        MouseDown="SvBox_MouseDown" MouseMove="SvBox_MouseMove" MouseUp="SvBox_MouseUp">
                    <Grid x:Name="GridSvBox">
                        <!-- Horizontal Hue -> White -->
                        <Rectangle x:Name="RectHueBase">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop x:Name="StopHueColor" Color="#FF0000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Vertical Black Overlay -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                    <GradientStop Color="#FF000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Circular Reticle Indicator -->
                        <Canvas x:Name="CanvasReticle" IsHitTestVisible="False">
                            <Ellipse x:Name="Reticle" Width="12" Height="12" Stroke="#FFFFFF" StrokeThickness="2" Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Vertical 1D Hue Rainbow Bar (18 x 188) -->
                <Border Grid.Column="2" Width="18" Height="188" BorderBrush="#383838" BorderThickness="1" ClipToBounds="True" Cursor="Hand"
                        MouseDown="HueBar_MouseDown" MouseMove="HueBar_MouseMove" MouseUp="HueBar_MouseUp">
                    <Grid x:Name="GridHueBar">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FF0000" Offset="0.0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.17"/>
                                    <GradientStop Color="#00FF00" Offset="0.33"/>
                                    <GradientStop Color="#00FFFF" Offset="0.50"/>
                                    <GradientStop Color="#0000FF" Offset="0.67"/>
                                    <GradientStop Color="#FF00FF" Offset="0.83"/>
                                    <GradientStop Color="#FF0000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Hue Indicator Slider Marker -->
                        <Canvas x:Name="CanvasHueThumb" IsHitTestVisible="False">
                            <Border x:Name="HueThumb" Width="18" Height="5" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Right Side: Large Color Preview Box, Hex Input, RGB Labels -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Large Color Preview Rectangle -->
                        <RowDefinition Height="Auto"/> <!-- Hex Label -->
                        <RowDefinition Height="Auto"/> <!-- Hex Input Box -->
                        <RowDefinition Height="Auto"/> <!-- R G B Values -->
                    </Grid.RowDefinitions>

                    <!-- Large Pure Color Preview Box (Matching Screenshot) -->
                    <Border Grid.Row="0" x:Name="BrdNewColor" Height="78" Background="#FF0000" BorderBrush="#383838" BorderThickness="1" CornerRadius="1"/>

                    <!-- Hex Label -->
                    <TextBlock Grid.Row="1" Text="Hex" FontSize="11" Foreground="#CCCCCC" Margin="0,10,0,3"/>

                    <!-- Hex Input Box -->
                    <Border Grid.Row="2" Background="#2B2B2B" BorderBrush="#454545" BorderThickness="1" CornerRadius="1" Height="26">
                        <TextBox x:Name="TxtHexInput" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" 
                                 FontFamily="Consolas, Segoe UI" FontSize="12" VerticalContentAlignment="Center" Padding="5,0"
                                 CaretBrush="#0090FF" MaxLength="7"/>
                    </Border>

                    <!-- R G B Values Readout -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="R " FontSize="11" Foreground="#AAAAAA"/>
                            <TextBlock x:Name="TxtRVal" Text="255" FontSize="11" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBlock Text="G " FontSize="11" Foreground="#AAAAAA"/>
                            <TextBlock x:Name="TxtGVal" Text="0" FontSize="11" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBlock Text="B " FontSize="11" Foreground="#AAAAAA"/>
                            <TextBlock x:Name="TxtBVal" Text="0" FontSize="11" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 2: 3-Row Color Swatches Grid (Exact Match to Windows Screenshot) -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: 14 Pure/Vibrant Rainbow Hues -->
                <UniformGrid Grid.Row="0" Columns="14">
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FF0000" Tag="#FF0000" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FF3D00" Tag="#FF3D00" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FF7A00" Tag="#FF7A00" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFB700" Tag="#FFB700" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFF200" Tag="#FFF200" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#76FF03" Tag="#76FF03" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#00E676" Tag="#00E676" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#1DE9B6" Tag="#1DE9B6" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#00E5FF" Tag="#00E5FF" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#0091EA" Tag="#0091EA" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#0022FF" Tag="#0022FF" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#651FFF" Tag="#651FFF" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#D500F9" Tag="#D500F9" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FF007F" Tag="#FF007F" Click="Swatch_Click"/>
                </UniformGrid>

                <!-- Row 2: Monochrome Grayscale Gradient + Pastels -->
                <UniformGrid Grid.Row="1" Columns="14">
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#E0E0E0" Tag="#E0E0E0" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#BDBDBD" Tag="#BDBDBD" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#9E9E9E" Tag="#9E9E9E" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#757575" Tag="#757575" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#616161" Tag="#616161" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#424242" Tag="#424242" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#000000" Tag="#000000" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFCDD2" Tag="#FFCDD2" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFE0B2" Tag="#FFE0B2" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFF9C4" Tag="#FFF9C4" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#DCEDC8" Tag="#DCEDC8" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#B2EBF2" Tag="#B2EBF2" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#D1C4E9" Tag="#D1C4E9" Click="Swatch_Click"/>
                </UniformGrid>

                <!-- Row 3: Light Pastels & Custom White Slots -->
                <UniformGrid Grid.Row="2" Columns="14">
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#F8FAFC" Tag="#F8FAFC" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#F1F5F9" Tag="#F1F5F9" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#E2E8F0" Tag="#E2E8F0" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#CBD5E1" Tag="#CBD5E1" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#94A3B8" Tag="#94A3B8" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#64748B" Tag="#64748B" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#475569" Tag="#475569" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#334155" Tag="#334155" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#1E293B" Tag="#1E293B" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#0F172A" Tag="#0F172A" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                    <Button Style="{StaticResource ModernSwatchStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                </UniformGrid>
            </Grid>

            <!-- 3: OK and Cancel Buttons Aligned to Bottom Right -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnApply" Content="OK" Style="{StaticResource WinDialogButtonStyle}" IsDefault="True" Margin="0,0,8,0" Click="BtnApply_Click"/>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource WinDialogButtonStyle}" IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
