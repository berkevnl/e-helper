        <!-- Theme Tokens (Default: Matching Reference Image Palette) -->
        <SolidColorBrush x:Key="WindowBg" Color="#14151B"/>
        <SolidColorBrush x:Key="CardBg" Color="#1C1E26"/>
        <SolidColorBrush x:Key="CardHoverBg" Color="#222530"/>
        <SolidColorBrush x:Key="CardBorder" Color="#252834"/>
        <SolidColorBrush x:Key="CardActiveBg" Color="#252834"/>
        <SolidColorBrush x:Key="CardActiveBorder" Color="#4C536A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#D4D7E2"/>
        <SolidColorBrush x:Key="TextMuted" Color="#656A7B"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="#252834"/>
        <SolidColorBrush x:Key="AccentColor" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4ADE80"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="SegmentBg" Color="#1E202A"/>
        <SolidColorBrush x:Key="SegmentBorder" Color="#2E3242"/>
        <SolidColorBrush x:Key="SegmentActiveBg" Color="#252834"/>
        <SolidColorBrush x:Key="SegmentActiveBorder" Color="#4C536A"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#22242F"/>
        <SolidColorBrush x:Key="BadgeBorder" Color="#2D313F"/>
        <SolidColorBrush x:Key="BtnUpdateBg" Color="#2A2E3D"/>
        <SolidColorBrush x:Key="BtnUpdateBorder" Color="#4C536A"/>
        <SolidColorBrush x:Key="BtnUpdateFg" Color="#FFFFFF"/>

        <!-- Modern ScrollBar Thumb Style -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="3" Background="{DynamicResource SegmentBorder}" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardActiveBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Vertical ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Progress Bar Style (Theme Accent Color Fill) -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource ProgressTrack}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Button Style -->
        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SegmentBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SegmentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Power Card Button Style -->
        <Style x:Key="PowerCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="68"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Update Action Button Style -->
        <Style x:Key="UpdateActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnUpdateBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnUpdateFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnUpdateBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button (Minimize & Close) -->
        <Style x:Key="WindowCtrlBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer Icon Button Style -->
        <Style x:Key="FooterIconBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer Exit Button Style -->
        <Style x:Key="FooterExitBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluid Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SegmentBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SegmentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" 
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextMuted}" 
                                          StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="toggle"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.4"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CardActiveBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Profile Banner Action Buttons -->
        <Style x:Key="ProfileBannerBtnCancel" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileBannerBtnConfirm" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardActiveBorder}"/>
            <Setter Property="Foreground" Value="#14151B"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Drop Shadow -->
    <Border x:Name="RootCard"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Profile Setup Banner -->
                <RowDefinition Height="Auto"/> <!-- 2: Güç Seçenekleri Header -->
                <RowDefinition Height="Auto"/> <!-- 3: Güç Seçenekleri Kartları -->
                <RowDefinition Height="Auto"/> <!-- 4: Sistem Kaynakları Header -->
                <RowDefinition Height="Auto"/> <!-- 5: CPU & GPU Kartları -->
                <RowDefinition Height="Auto"/> <!-- 6: RAM & SSD Kartı -->
                <RowDefinition Height="Auto"/> <!-- 7: RGB Klavye Aydınlatma Kartı -->
                <RowDefinition Height="Auto"/> <!-- 8: Güncelleme Kartı (Varsa) -->
                <RowDefinition Height="Auto"/> <!-- 9: Footer -->
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- 0: HEADER (Title, Version Pill, Window Ctrls) -->
            <!-- ========================================== -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title + Version Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="E-HELPER" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" 
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Border Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource BadgeBorder}" 
                            BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppVersionPill" Text="v1.3.0" FontSize="10.5" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="NoWrap"/>
                    </Border>
                </StackPanel>

                <!-- Right: Window Controls (Close) -->
                <Button Grid.Column="1" x:Name="BtnClose" Style="{StaticResource WindowCtrlBtnStyle}" Click="BtnClose_Click" ToolTip="Kapat / Tepsiye Gizle" VerticalAlignment="Center">
                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ========================================== -->
            <!-- 1: PROFILE SETUP BANNER (Mod Ayarlama)     -->
            <!-- ========================================== -->
            <Border x:Name="PnlProfileSetupBanner" Grid.Row="1" 
                    Background="{DynamicResource CardHoverBg}" 
                    BorderBrush="{DynamicResource CardActiveBorder}" 
                    BorderThickness="1.5" CornerRadius="8" 
                    Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtProfileSetupBannerTitle" Text="🎯 Profil Ayar Modu" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtProfileSetupBannerDesc" Text="Güç ve RGB ayarlarını seçip onaylayın" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCancelProfileSettings" Content="İptal" Style="{StaticResource ProfileBannerBtnCancel}" Click="BtnCancelProfileSettings_Click" Margin="0,0,6,0"/>
                        <Button x:Name="BtnConfirmProfileSettings" Content="✓ Onayla" Style="{StaticResource ProfileBannerBtnConfirm}" Click="BtnConfirmProfileSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 2: GÜÇ SEÇENEKLERİ BAŞLIĞI                -->
            <!-- ========================================== -->
            <TextBlock Grid.Row="2" x:Name="TxtHeaderPowerOptions" Text="GÜÇ SEÇENEKLERİ" 
                       FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

            <!-- ========================================== -->
            <!-- 3: GÜÇ SEÇENEKLERİ KARTLARI (3'lü Grid)   -->
            <!-- ========================================== -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPowerOffice" Grid.Column="0" Click="BtnPowerOffice_Click" Style="{StaticResource PowerCardButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="17" Height="17" Margin="0,0,0,5">
                            <Path x:Name="IconPowerOffice" Data="{StaticResource IconEco}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6"/>
                        </Viewbox>
                        <TextBlock x:Name="TxtPowerOfficeTitle" Text="Tasarruf" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="TxtPowerOfficeSub" Text="Sessiz" FontSize="9.5" 
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnPowerGaming" Grid.Column="2" Click="BtnPowerGaming_Click" Style="{StaticResource PowerCardButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="17" Height="17" Margin="0,0,0,5">
                            <Path x:Name="IconPowerGaming" Data="{StaticResource IconBalanced}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6"/>
                        </Viewbox>
                        <TextBlock x:Name="TxtPowerGamingTitle" Text="Dengeli" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="TxtPowerGamingSub" Text="Günlük" FontSize="9.5" 
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnPowerTurbo" Grid.Column="4" Click="BtnPowerTurbo_Click" Style="{StaticResource PowerCardButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="17" Height="17" Margin="0,0,0,5">
                            <Path x:Name="IconPowerTurbo" Data="{StaticResource IconTurbo}" Fill="{DynamicResource TextMuted}"/>
                        </Viewbox>
                        <TextBlock x:Name="TxtPowerTurboTitle" Text="Performans" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="TxtPowerTurboSub" Text="Turbo" FontSize="9.5" 
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ========================================== -->
            <!-- 4: SİSTEM KAYNAKLARI BAŞLIĞI              -->
            <!-- ========================================== -->
            <TextBlock Grid.Row="4" x:Name="TxtHeaderSystemResources" Text="SİSTEM KAYNAKLARI" 
                       FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

            <!-- ========================================== -->
            <!-- 5: CPU & GPU KARTLARI (Yan Yana)          -->
            <!-- ========================================== -->
            <Grid Grid.Row="5" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU CARD (İŞLEMCİ) -->
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" 
                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Dot + Header (left) | Model (right) -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentCyan}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCpuHeader" Text="İŞLEMCİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCpuModel" Text="i7-13700H" FontSize="10.5" Foreground="{DynamicResource TextMuted}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Row 1: Large Temp (left) | Usage (right) -->
                        <Grid Grid.Row="1" Margin="0,6,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCpuTemp" Text="68" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="°C" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCpuUsagePercent" Text="44%" FontSize="12" FontWeight="Bold" 
                                           Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtCpuUsageLabel" Text="Kullanım" FontSize="9.5" 
                                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Fan (left) | RPM (right) -->
                        <Grid Grid.Row="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFanMini}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtCpuFanLabel" Text="Fan" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCpuRpm" Text="2800 RPM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- GPU CARD (EKRAN KARTI) -->
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" 
                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Dot + Header (left) | Model (right) -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentGreen}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtGpuHeader" Text="EKRAN KARTI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGpuModel" Text="RTX 4070" FontSize="10.5" Foreground="{DynamicResource TextMuted}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Row 1: Large Temp (left) | Usage (right) -->
                        <Grid Grid.Row="1" Margin="0,6,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtGpuTemp" Text="72" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="°C" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtGpuUsagePercent" Text="82%" FontSize="12" FontWeight="Bold" 
                                           Foreground="{DynamicResource AccentGreen}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtGpuUsageLabel" Text="Kullanım" FontSize="9.5" 
                                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Fan (left) | RPM (right) -->
                        <Grid Grid.Row="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFanMini}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtGpuFanLabel" Text="Fan" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGpuRpm" Text="3100 RPM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 6: RAM & SSD KARTI (Kombine Tek Kart)      -->
            <!-- ========================================== -->
            <Border Grid.Row="6" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Row 1: RAM Header -->
                    <Grid Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path x:Name="IconRamPath" Data="{StaticResource IconRam}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.5"/>
                            </Viewbox>
                            <TextBlock x:Name="TxtRamLabel" Text="RAM (Bellek)" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRamPercent" Text="54%" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtRamUsage" Text="•  17.2 / 32 GB" FontSize="11" 
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="PbRamUsage" Value="54" Maximum="100" 
                                 Foreground="{DynamicResource AccentColor}"
                                 Style="{StaticResource ModernProgressBarStyle}" Margin="0,0,0,9"/>

                    <!-- Row 2: SSD Header -->
                    <Grid Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path x:Name="IconDiskPath" Data="{StaticResource IconDisk}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.5"/>
                            </Viewbox>
                            <TextBlock x:Name="TxtSsdLabel" Text="SSD (Depolama)" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSsdPercent" Text="62%" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtSsdUsage" Text="•  1.2 / 2.0 TB" FontSize="11" 
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="PbSsdUsage" Value="62" Maximum="100" 
                                 Foreground="{DynamicResource AccentColor}"
                                 Style="{StaticResource ModernProgressBarStyle}"/>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 7: RGB KLAVYE AYDINLATMA KARTI             -->
            <!-- ========================================== -->
            <Border Grid.Row="7" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="12,11" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconKeyboard}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6"/>
                        </Viewbox>
                        <TextBlock x:Name="TxtHeaderRgb" Text="RGB Klavye Aydınlatma" FontSize="12" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Effect Dropdown Selector -->
                    <ComboBox x:Name="CmbLedMode" Style="{StaticResource ModernComboBoxStyle}" 
                              ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}" 
                              SelectionChanged="CmbLedMode_SelectionChanged" Margin="0,0,0,10">
                        <ComboBoxItem x:Name="CmbItemRainbow" Tag="Rainbow">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconModeRainbow}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtItemRainbowLabel" Text="Gökkuşağı Akışı" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="CmbItemCycle" Tag="Cycle">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconModeCycle}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtItemCycleLabel" Text="Spektrum" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="CmbItemStatic" Tag="Static">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconModeStatic}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtItemStaticLabel" Text="Sabit" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="CmbItemBreathing" Tag="Breathing">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconModeBreathing}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtItemBreathingLabel" Text="Nefes" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="CmbItemDynamic" Tag="ColorfulCycle">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconModeDynamic}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtItemDynamicLabel" Text="Dinamik" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="CmbItemTripleZone" Tag="TripleZone">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconModeTripleZone}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtItemTripleZoneLabel" Text="3-Bölge Özel" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <!-- Sub-Controls: Left (Brightness 0/50/100) | Right (Speed or Color) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Brightness -->
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtBrightnessTitle" Text="Parlaklık" FontSize="10.5" 
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnBright0" Content="%0" Style="{StaticResource SegmentButtonStyle}" Click="BtnBright0_Click"/>
                                <Button Grid.Column="2" x:Name="BtnBright50" Content="%50" Style="{StaticResource SegmentButtonStyle}" Click="BtnBright50_Click"/>
                                <Button Grid.Column="4" x:Name="BtnBright100" Content="%100" Style="{StaticResource SegmentButtonStyle}" Click="BtnBright100_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Right Column: Speed OR Color -->
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="TxtDynamicControlTitle" Text="Hız" FontSize="10.5" 
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>

                            <!-- View 1: 3-Tier Speed Selector (When Cycle or Rainbow is selected) -->
                            <Grid x:Name="GridSpeedSelector" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnSpeedSlow" Content="Yavaş" Style="{StaticResource SegmentButtonStyle}" Click="BtnSpeedSlow_Click"/>
                                <Button Grid.Column="2" x:Name="BtnSpeedMedium" Content="Orta" Style="{StaticResource SegmentButtonStyle}" Click="BtnSpeedMedium_Click"/>
                                <Button Grid.Column="4" x:Name="BtnSpeedFast" Content="Hızlı" Style="{StaticResource SegmentButtonStyle}" Click="BtnSpeedFast_Click"/>
                            </Grid>

                            <!-- View 2: Single Color Picker Button (When Static, Breathing, or Dynamic is selected) -->
                            <Grid x:Name="GridSingleColorSelector" Height="28" Visibility="Collapsed">
                                <Button x:Name="BtnOpenColorPicker" Height="28" Style="{StaticResource SegmentButtonStyle}" Click="BtnOpenColorPicker_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="EllipseSingleColor" Width="10" Height="10" Fill="#22D3EE" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtSingleColorHex" Text="#22D3EE" FontSize="11" FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0"/>
                                        <Viewbox x:Name="ViewboxPaletteIcon" Width="11" Height="11">
                                            <Path Data="{StaticResource IconPalette}" Fill="{DynamicResource TextMuted}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- View 3: 3-Zone Color Selector (When 3-Zone mode is selected) -->
                            <Grid x:Name="GridTripleZoneSelector" Height="28" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnZoneLeft" Height="28" Style="{StaticResource SegmentButtonStyle}" Click="BtnZoneLeft_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="EllipseZoneLeft" Width="8" Height="8" Fill="#00E5FF" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtZoneLeftLabel" Text="Sol" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" x:Name="BtnZoneCenter" Height="28" Style="{StaticResource SegmentButtonStyle}" Click="BtnZoneCenter_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="EllipseZoneCenter" Width="8" Height="8" Fill="#22C55E" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtZoneCenterLabel" Text="Orta" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" x:Name="BtnZoneRight" Height="28" Style="{StaticResource SegmentButtonStyle}" Click="BtnZoneRight_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="EllipseZoneRight" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtZoneRightLabel" Text="Sağ" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 8: GÜNCELLEME KARTI (Yalnızca Güncelleme Varsa) -->
            <!-- ========================================== -->
            <Border Grid.Row="8" x:Name="CardUpdateBanner" Background="{DynamicResource CardBg}" 
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" 
                    Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Info Icon -->
                    <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6"/>
                    </Viewbox>

                    <!-- Middle: Title -->
                    <TextBlock Grid.Column="1" x:Name="TxtUpdateBannerMessage" 
                               Text="v1.3.0 Güncellemesi Mevcut" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,8,0"/>

                    <!-- Right: Action Button -->
                    <Button Grid.Column="2" x:Name="BtnUpdateAction" Content="Güncelle" Click="BtnUpdateAction_Click" 
                            MinWidth="80" Height="28" Padding="14,0" 
                            Style="{StaticResource UpdateActionButtonStyle}"/>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 9: FOOTER / ALT BAR                       -->
            <!-- ========================================== -->
            <Grid Grid.Row="9" VerticalAlignment="Center" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Laptop Model + Status ("Excalibur G911 - Güncel") -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtModelBadge" Text="Excalibur G911" FontSize="11" FontWeight="Medium" 
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtModelStatus" Text=" - Güncel" FontSize="11" FontWeight="Medium" 
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Settings, Theme, Lang, Divider, Exit -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Settings -->
                    <Button x:Name="BtnSettings" Style="{StaticResource FooterIconBtnStyle}" Click="BtnSettings_Click" ToolTip="Ayarlar" Margin="0,0,3,0">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6"/>
                        </Viewbox>
                    </Button>

                    <!-- Theme Toggle -->
                    <Button x:Name="BtnThemeToggle" Style="{StaticResource FooterIconBtnStyle}" Click="BtnThemeToggle_Click" ToolTip="Tema (Koyu / Açık)" Margin="0,0,3,0">
                        <Viewbox Width="14" Height="14">
                            <Path x:Name="IconThemePath" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Button>

                    <!-- Language Toggle -->
                    <Button x:Name="BtnLangToggle" Style="{StaticResource FooterIconBtnStyle}" MinWidth="52" Padding="6,0" Click="BtnLangToggle_Click" ToolTip="Dil (TR / EN)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGlobe}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6"/>
                            </Viewbox>
                            <TextBlock x:Name="TxtLangCode" Text="TR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Vertical Divider -->
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource CardBorder}" Margin="6,0"/>

                    <!-- Exit App -->
                    <Button x:Name="BtnExitApp" Style="{StaticResource FooterExitBtnStyle}" Click="BtnExitApp_Click" ToolTip="Çıkış">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPower}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7"/>
                            </Viewbox>
                            <TextBlock x:Name="TxtExitLabel" Text="Çıkış" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
