<Window x:Class="EHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EHelper"
        mc:Ignorable="d"
        Title="E-Helper"
        Icon="/Assets/app.ico"
        Height="660" 
        Width="425"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Dynamic Theme Tokens (Default: G-Helper Authentic Matte Dark) -->
        <SolidColorBrush x:Key="WindowBg" Color="#161616"/>
        <SolidColorBrush x:Key="TileBg" Color="#252525"/>
        <SolidColorBrush x:Key="TileHoverBg" Color="#323232"/>
        <SolidColorBrush x:Key="TileBorder" Color="#383838"/>
        <SolidColorBrush x:Key="TileActiveBg" Color="#192738"/>
        <SolidColorBrush x:Key="TileActiveBorder" Color="#0090FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E8E93"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0090FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- G-Helper Square Tile Button Style -->
        <Style x:Key="GHelperTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TileBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TileHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Selected Tile Style (Crisp Electric Blue Border) -->
        <Style x:Key="ActiveGHelperTileStyle" TargetType="Button" BasedOn="{StaticResource GHelperTileStyle}">
            <Setter Property="Background" Value="{DynamicResource TileActiveBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileActiveBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Compact Bottom Action Button Style -->
        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TileBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TileHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Button Style for side-by-side Theme & Lang -->
        <Style x:Key="FooterMiniBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TileBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TileHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Color Preset Button -->
        <Style x:Key="ColorPresetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle Fill="{TemplateBinding Background}" RadiusX="3" RadiusY="3" Stroke="#444444" StrokeThickness="1"/>
                            <Rectangle x:Name="highlight" RadiusX="3" RadiusY="3" Stroke="White" StrokeThickness="1.5" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="highlight" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern G-Helper Flat ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{DynamicResource TileBg}"
                    BorderBrush="{DynamicResource TileBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{DynamicResource TextMuted}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource TileHoverBg}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TileActiveBorder}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="GHelperComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="10,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource WindowBg}"
                                        BorderBrush="{DynamicResource TileBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,4"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GHelperComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TileHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TileActiveBg}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource TileActiveBorder}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Filled Track Slider Style (G-Helper / Windows 11 style) -->
        <Style x:Key="ModernBrightnessSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22" Background="Transparent">
                            <!-- Background Full Track (Dark Gray) -->
                            <Border Height="4" Margin="6,0,6,0" Background="{DynamicResource ProgressTrack}" CornerRadius="2" VerticalAlignment="Center"/>
                            
                            <!-- Track Layer with Thumb and Decrease Button (Filled Blue) -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="4" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{DynamicResource AccentBlue}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" CornerRadius="7" 
                                                        Background="{DynamicResource TextPrimary}" 
                                                        BorderBrush="{DynamicResource AccentBlue}" BorderThickness="2">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Height="4" VerticalAlignment="Center">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Shadow Separator to keep Text 100% Crisp and ClearType enabled -->
    <Grid Margin="8">
        <!-- Shadow Caster Layer (Isolated so no child text is rasterized into bitmap) -->
        <Border Background="{DynamicResource WindowBg}" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.65"/>
            </Border.Effect>
        </Border>

        <!-- Main Sharp Card Layer -->
        <Border Background="{DynamicResource WindowBg}" 
                BorderBrush="{DynamicResource TileBorder}" 
                BorderThickness="1" 
                CornerRadius="8"
                RenderOptions.ClearTypeHint="Enabled"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType"
                TextOptions.TextHintingMode="Fixed">

            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header (G-Helper Style) -->
                    <RowDefinition Height="Auto"/> <!-- 1: Performance Mode & CPU -->
                    <RowDefinition Height="Auto"/> <!-- 2: GPU Mode & Telemetry -->
                    <RowDefinition Height="Auto"/> <!-- 3: System Resources (RAM & SSD) -->
                    <RowDefinition Height="Auto"/> <!-- 4: Keyboard Lighting -->
                    <RowDefinition Height="Auto"/> <!-- 5: System Settings (Startup) -->
                    <RowDefinition Height="*"/>    <!-- 6: Spacer -->
                    <RowDefinition Height="Auto"/> <!-- 7: Footer Buttons -->
                </Grid.RowDefinitions>

                <!-- 0: Header (Clean title & close button, draggable) -->
                <Grid Grid.Row="0" Margin="0,0,0,14" Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="E-Helper — " FontSize="12" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtModelBadge" Text="Casper Excalibur" FontSize="12" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnCloseToTray" Content="✕" Width="22" Height="22" HorizontalAlignment="Right"
                            Foreground="{DynamicResource TextMuted}" Background="Transparent" BorderThickness="0" 
                            FontSize="11" Cursor="Hand" ToolTip="Gizle" Click="BtnCloseToTray_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#333333"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 1: Section: Performans Modu (G-Helper exact style) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <!-- Section Header Row: Title on Left | CPU Temp & RPM on Right -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPowerModeTitle" Text="Performans Modu: Dengeli" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="CPU: " FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtCpuTemp" Text="--°C" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                            <TextBlock Text="Fan: " FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtCpuRpm" Text="--RPM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 3 G-Helper Tiles: Tasarruf, Dengeli, Performans -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tasarruf Button (Bicycle as in G-Helper) -->
                        <Button x:Name="BtnModeOffice" Grid.Column="0" Style="{StaticResource GHelperTileStyle}" Click="BtnModeOffice_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🚲" FontSize="18" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtModeOfficeLabel" Text="Tasarruf" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Dengeli Button (Car as in G-Helper) -->
                        <Button x:Name="BtnModeGaming" Grid.Column="2" Style="{StaticResource ActiveGHelperTileStyle}" Click="BtnModeGaming_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🚗" FontSize="18" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtModeGamingLabel" Text="Dengeli" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Performans Button (Rocket as in G-Helper) -->
                        <Button x:Name="BtnModeHighPerf" Grid.Column="4" Style="{StaticResource GHelperTileStyle}" Click="BtnModeHighPerf_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="18" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtModeHighPerfLabel" Text="Performans" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 2: Section: GPU Modu & Telemetri -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtGpuHeader" Text="GPU Modu: Ayrık / Hibrit" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="GPU: " FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="TxtGpuTemp" Text="--°C" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                        <TextBlock Text="Fan: " FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="TxtGpuRpm" Text="--RPM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Grid>

                <!-- 3: Section: Sistem Kaynakları (RAM & SSD Metrics) -->
                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSysResourcesHeader" Text="Sistem Kaynakları" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2 Compact Resource Tiles -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RAM Metric Card -->
                        <Border Grid.Column="0" Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtRamHeader" Text="RAM Bellek" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="TxtRamPercent" Text="--%" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                </Grid>
                                <TextBlock x:Name="TxtRamUsage" Text="-- / -- GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <ProgressBar x:Name="PbRamUsage" Height="3" Margin="0,6,0,0" Value="50" Maximum="100" 
                                             Foreground="{DynamicResource AccentGreen}" Background="{DynamicResource ProgressTrack}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- SSD Metric Card -->
                        <Border Grid.Column="2" Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtSsdHeader" Text="SSD Disk (C:)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="TxtSsdPercent" Text="--%" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
                                </Grid>
                                <TextBlock x:Name="TxtSsdUsage" Text="-- / -- GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <ProgressBar x:Name="PbSsdUsage" Height="3" Margin="0,6,0,0" Value="50" Maximum="100" 
                                             Foreground="{DynamicResource AccentBlue}" Background="{DynamicResource ProgressTrack}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 4: Section: Laptop Klavyesi (Lighting & RGB Controls) -->
                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⌨" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtKeyboardHeader" Text="Laptop Klavyesi" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LblBrightnessHeader" Text="Parlaklık: " FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtBrightnessIcon" Text="%100" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Mode Selector Dropdown & Side Color Button (G-Helper / User Reference Style) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Mode Dropdown Selector -->
                        <ComboBox x:Name="CmbLedMode" Grid.Column="0" 
                                  Style="{StaticResource GHelperComboBoxStyle}" 
                                  ItemContainerStyle="{StaticResource GHelperComboBoxItemStyle}"
                                  SelectionChanged="CmbLedMode_SelectionChanged">
                            <ComboBoxItem Content="✨ Sabit" Tag="Static"/>
                            <ComboBoxItem Content="💨 Nefes" Tag="Breathing"/>
                            <ComboBoxItem Content="💫 Dinamik" Tag="ColorfulCycle"/>
                            <ComboBoxItem Content="🌈 Gökkuşağı" Tag="Rainbow"/>
                            <ComboBoxItem Content="🎨 3-Bölge" Tag="TripleZone"/>
                        </ComboBox>

                        <!-- Right: Side Color Button (Always visible; enabled for Static, Breathing, TripleZone) -->
                        <Button x:Name="BtnModeColorAction" Grid.Column="2" 
                                Style="{StaticResource GHelperTileStyle}" 
                                Height="32" Padding="0"
                                Click="BtnModeColorAction_Click">
                            <Grid Width="160" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtModeColorActionLabel" Text="Renk" FontSize="12" 
                                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Border x:Name="BrdModeColorIndicator" Width="14" Height="14" CornerRadius="2" 
                                        Background="#EF4444" BorderBrush="#88FFFFFF" BorderThickness="1" 
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Brightness Slider -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblBrightnessTitle" Text="Parlaklık" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderBrightness" Grid.Column="1" Margin="12,0,0,0" Minimum="0" Maximum="2" Value="2" 
                                Style="{StaticResource ModernBrightnessSliderStyle}"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderBrightness_ValueChanged"/>
                    </Grid>

                    <!-- Bird's-eye 2D 3-Piece Keyboard Symbol (Visible only in 3-Bölge mode) -->
                    <!-- Each segment has its independent crisp border and color swatch -->
                    <Border x:Name="PnlTripleZoneDiagram" Visibility="Collapsed" Margin="0,0,0,6" 
                            Background="{DynamicResource DiagramBg}" BorderBrush="{DynamicResource TileBorder}" 
                            BorderThickness="1" CornerRadius="5" Padding="6,6"
                            RenderOptions.ClearTypeHint="Enabled"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType"
                            TextOptions.TextHintingMode="Fixed">
                        <StackPanel>
                            <!-- Minimalist Header -->
                            <Grid Margin="2,0,2,6">
                                <TextBlock x:Name="TxtDiagramTitle" Text="Bölge Seç ve Rengini Belirle:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>

                            <!-- 2D Bird's-eye 3-Piece Keyboard Schematic -->
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Piece 1: Sol Parça (Left Zone) -->
                                <Border x:Name="BrdZoneLeft" Grid.Column="0" CornerRadius="4" BorderThickness="1" 
                                        BorderBrush="{DynamicResource TileBorder}" Background="{DynamicResource TileBg}"
                                        Cursor="Hand" MouseLeftButtonDown="BtnZoneLeft_Click">
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="DotZoneLeft" Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="#00E5FF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblZoneLeft" Grid.Column="1" Text="Sol" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Piece 2: Orta Parça (Center Zone) -->
                                <Border x:Name="BrdZoneCenter" Grid.Column="2" CornerRadius="4" BorderThickness="1" 
                                        BorderBrush="{DynamicResource TileBorder}" Background="{DynamicResource TileBg}"
                                        Cursor="Hand" MouseLeftButtonDown="BtnZoneCenter_Click">
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="DotZoneCenter" Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="#22C55E" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblZoneCenter" Grid.Column="1" Text="Orta" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Piece 3: Sağ Parça (Right Zone) -->
                                <Border x:Name="BrdZoneRight" Grid.Column="4" CornerRadius="4" BorderThickness="1" 
                                        BorderBrush="{DynamicResource TileBorder}" Background="{DynamicResource TileBg}"
                                        Cursor="Hand" MouseLeftButtonDown="BtnZoneRight_Click">
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="DotZoneRight" Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblZoneRight" Grid.Column="1" Text="Sağ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5: System Settings (Startup Checkbox) -->
                <StackPanel Grid.Row="5" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkAutoStart" Content="Başlangıçta Çalıştır" 
                              Foreground="{DynamicResource TextPrimary}" FontSize="12" 
                              VerticalContentAlignment="Center" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                </StackPanel>

                <!-- 6: Spacer -->
                <Grid Grid.Row="6"/>

                <!-- 7: Footer Action Area -->
                <Grid Grid.Row="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top row: Version info on left, Theme & Lang side-by-side on right -->
                        <RowDefinition Height="Auto"/> <!-- Bottom row: Updates, Refresh, Exit -->
                    </Grid.RowDefinitions>

                    <!-- Top Sub-Row: Version on left, Theme & Language toggles on right -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Version Info: Small and legible directly above Updates button -->
                        <TextBlock x:Name="TxtVersionInfo" Grid.Column="0" Text="v1.0.1" FontSize="10" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>

                        <!-- Side-by-side Theme and Language toggles directly above Exit button -->
                        <Grid Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnThemeToggle" Grid.Column="0" Content="☀️ Açık" Style="{StaticResource FooterMiniBtnStyle}" Click="BtnThemeToggle_Click"/>
                            <Button x:Name="BtnLangToggle" Grid.Column="2" Content="🌐 EN" Style="{StaticResource FooterMiniBtnStyle}" ToolTip="Dili Değiştir / Change Language" Click="BtnLangToggle_Click"/>
                        </Grid>
                    </Grid>

                    <!-- Bottom Sub-Row: Updates, Refresh, Exit -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Updates button -->
                        <Button x:Name="BtnCheckUpdates" Grid.Column="0" Content="📥 Güncellemeler" Style="{StaticResource FooterBtnStyle}" Click="BtnCheckUpdates_Click"/>

                        <!-- Refresh button -->
                        <Button x:Name="BtnRefreshTelemetry" Grid.Column="2" Content="🔃 Yenile" Style="{StaticResource FooterBtnStyle}" Click="BtnRefreshTelemetry_Click"/>

                        <!-- Exit button -->
                        <Button x:Name="BtnExitApp" Grid.Column="4" Content="➔ Çıkış" Style="{StaticResource FooterBtnStyle}" Click="BtnExitApp_Click"/>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
